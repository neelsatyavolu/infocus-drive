# Required by docker-compose (it refuses to start if these are unset).
PUBLIC_BASE_URL=https://drive.example.com
# Direct NAS gateway (same app, no Cloudflare Tunnel). Browser auto-switches when reachable.
# Empty disables the LAN shortcut.
LAN_ORIGIN=http://192.168.1.50:8790
LAN_PREFER=true
# Multi-volume + Samba share discovery (Camp MAC, Archive, …)
SHARES_VOLUMES=/data/volume1,/data/volume2
SAMBA_SHARES_CONF=/config/smbshare.conf
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Email-code sign-in (Resend verified sender; never commit real credentials).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_SIGN_IN_DB_PATH=/config/email_sign_in.sqlite3
# Terminal (infocus CLI) sign-ins — hashed tokens, on the persistent config mount
CLI_TOKENS_DB_PATH=/config/cli_tokens.sqlite3
ALLOWED_EMAIL_DOMAINS=example.org,students.example.org
# Google account chooser hosted domain (hd=); empty = no hint. Other ALLOWED_EMAIL_DOMAINS still work after login.
GOOGLE_HOSTED_DOMAIN=example.org
# Optional exceptions: full Google email → NAS username (e.g. personal Gmail).
# Emails outside ALLOWED_EMAIL_DOMAINS are denied unless listed here — even if local-part matches a NAS user.
# Copy config/user_map.example.json to config/user_map.json.
# USER_MAP_PATH=/config/user_map.json

# Finder / SMB network drive (UGOS Samba — NAS password, not Google OAuth)
SMB_HOST=192.168.1.50
# Optional friendlier NetBIOS/DNS name if the NAS advertises one
SMB_HOSTNAME=
SMB_SHARE_INFOCUS=InFocus Drive

# Cloudflare Zero Trust (WARP) for remote SMB — see docs/REMOTE-SMB-WARP.md
# Leave empty if you don't use WARP.
WARP_TEAM_NAME=your-team
WARP_ENROLL_URL=https://your-team.cloudflareaccess.com/warp

# Machine auth for infocus-packages → Package Cycles storage
# Same secret must be set on packages as DRIVE_SERVICE_TOKEN
PACKAGES_SERVICE_TOKEN=
# NAS username (uid>=1000) that may write under Package Cycles
PACKAGES_SERVICE_USER=
PACKAGES_ROOT=Package Cycles
# Packages website roster (same bearer as PACKAGES_SERVICE_TOKEN)
# Empty disables roster sync.
PACKAGES_ROSTER_URL=
PACKAGES_ROSTER_SNAPSHOT_PATH=/config/packages_roster.json

# UGOS user create (legacy). Provisioning uses userd (Linux useradd on the host).
UGOS_API_URL=http://127.0.0.1:9999
# Requires scripts/install_ugos_sso.py on the NAS; no additional secret needed.
UGOS_SSO_ENABLED=true
# UGOS portal URL for the sidebar link (separate hostname); empty hides it.
UGOS_ADMIN_PATH=https://ugos.example.com/
UGOS_ADMIN_USER=admin
UGOS_ADMIN_PASSWORD=
UGOS_SYNC_GROUP=InFocus Members
# Localhost user provisioner (infocus-userd). Create-if-missing; never edits USER_SYNC_PROTECTED_USERNAMES.
USERD_URL=http://127.0.0.1:8791
USERD_TOKEN=
USER_SYNC_PROTECTED_USERNAMES=admin
USER_SYNC_PROTECTED_EMAILS=admin@example.org

# Meetings Scribe (docs/MEETINGS-SCRIBE.md)
# Drive <-> Scribe secret, its own random value (openssl rand -hex 32). Required.
SCRIBE_INTERNAL_TOKEN=
# Portal origin (scribe page + notes relay), e.g. https://portal.example.com
PORTAL_BASE_URL=
# Meeting room Worker origin, e.g. https://rooms.example.com
MEETING_ROOM_URL=
SCRIBE_URL=http://127.0.0.1:8792
# Drive-relative folder for notes (the only folder mounted into the Scribe).
IFD_MEETINGS_ROOT=.ifd-meetings
SCRIBE_WHISPER_MODEL=small.en
SCRIBE_WHISPER_THREADS=2
# Memory cap for the whisper child (MB); a 20-minute piece above it becomes a gap in the notes.
SCRIBE_WHISPER_MAX_MB=2000
SCRIBE_OLLAMA_MODEL=qwen2.5:1.5b
# Optional: Cloudflare Workers AI writes meeting summaries when both are set; the local model
# above is the fallback. The token needs only the "Workers AI" permission. The transcript is sent
# to Cloudflare for that request (no retention, no training); leave empty to keep everything local.
SCRIBE_WORKERS_AI_ACCOUNT_ID=
SCRIBE_WORKERS_AI_TOKEN=
SCRIBE_WORKERS_AI_MODEL=@cf/openai/gpt-oss-120b
SCRIBE_TIMEZONE=America/Los_Angeles
